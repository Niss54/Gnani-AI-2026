# ==============================================================================
# RevClaim AI — Production Environment Variables Configuration
# Built for The Great Indian AI Challenge & Agentic AI Hackathon by Gnani.ai
# ==============================================================================

# 1. Sovereign Indic Voice Engine (Gnani.ai Vachana: Prisma v3.0 STT + Timbre v3.0 TTS)
GNANI_API_KEY=your_gnani_vachana_api_key_here
GNANI_API_BASE_URL=https://api.vachana.ai

# 2. Razorpay Payment Gateway (Instant Indian UPI, QR, Cards & NetBanking)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# 3. High-EQ LLM Engines (Groq LPU Sub-200ms Primary + Gemini Secondary)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# 4. WebRTC Voice Engine (LiveKit Cloud)
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here
LIVEKIT_URL=wss://your-project.livekit.cloud
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# 5. Sovereign Database & Ledger (Supabase PostgreSQL + RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 6. Autonomous Settlement Email Rail (Resend)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=RevClaim AI <onboarding@resend.dev>

# 7. Real PSTN Outbound Telephony Trunking (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# 8. Production Endpoints & Host URLs
NEXT_PUBLIC_APP_URL=https://rev-claim-ai.vercel.app
NEXT_PUBLIC_BACKEND_URL=https://gnani-ai-2026.onrender.com
BACKEND_URL=https://gnani-ai-2026.onrender.com
NODE_ENV=production

# 9. Optional Secondary International Fallbacks
ELEVENLABS_API_KEY=your_optional_elevenlabs_key
DEEPGRAM_API_KEY=your_optional_deepgram_key
MEM0_API_KEY=your_optional_mem0_key
