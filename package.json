{
  "name": "revclaim-ai-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "RevClaim AI — Autonomous Indic Voice Agent for Unpaid Invoices & B2B Revenue Recovery",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build && node -e \"const fs=require('fs'); if(fs.existsSync('frontend/.next')) fs.cpSync('frontend/.next', '.next', {recursive:true}); if(fs.existsSync('frontend/public')) fs.cpSync('frontend/public', 'public', {recursive:true});\"",
    "start": "npm --prefix frontend run start",
    "lint": "npm --prefix frontend run lint",
    "test": "node tests/e2e.test.mjs",
    "test:gnani": "node tests/gnani-benchmark.mjs",
    "benchmark:gnani": "node scripts/benchmark-gnani.js",
    "test:all": "node tests/gnani-benchmark.mjs && node tests/e2e.test.mjs",
    "verify:voice-contract": "node scripts/run-python.js scripts/verify_voice.py --mode contract",
    "verify:dataset": "node scripts/run-python.js training/validate_data.py --manifest training/manifests/revclaim-v1.json",
    "eval:dialogue": "node scripts/run-python.js training/evaluate.py --run artifacts/training/revclaim-sft-candidate-001 --split development --compare corrected-hosted,base",
    "eval:voice-offline": "node scripts/run-python.js scripts/verify_voice.py --mode voice-offline",
    "verify:release": "node scripts/run-python.js scripts/verify_voice.py --mode release"
  }
}
